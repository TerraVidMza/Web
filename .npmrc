# Un desajuste de version de Node tiene que fallar al instalar, con el nombre
# del paquete y el rango que pide, y no doce minutos despues como un test roto.
#
# Es lo que faltaba cuando el CI corria en Node 20: `jsdom` pide 22.22.2+ y
# `npm ci` solo lo avisaba con un warning entre 600 lineas de salida.
engine-strict=true
