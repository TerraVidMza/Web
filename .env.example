# URL base de la API del Backend, con el prefijo /api incluido.
#
# Obligatoria: la aplicacion valida el entorno al arrancar y falla con un error
# explicito si falta. Antes habia un fallback silencioso a localhost, que en
# produccion significaba apuntar la app al localhost de quien la abriera.
VITE_API_URL=http://localhost:3000/api
